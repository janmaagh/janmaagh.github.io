{
  "name": "greenhouse",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "greenhouse-db",
      "database_id": "c318ee0c-a383-4fd9-ac88-e4d8a0f9b13b"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * 1", "0 4 * * *"]
  }
}
